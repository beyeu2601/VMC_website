# Copy to .env and fill in real values. Never commit .env.

# Neon Postgres connection string. Use a separate Neon branch for local dev.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Random string, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Vercel Blob read/write token. If empty, uploads fall back to local disk (dev only).
BLOB_READ_WRITE_TOKEN=

# Gemini API key, server only (used from M5)
GEMINI_API_KEY=

# Public site URL, no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
